{
  "name": "wavewatch",
  "version": "1.0.0",
  "description": "WaveWatch - Surf forecasting application",
  "private": true,
  "scripts": {
    "lint:js": "eslint 'src/**/*.{js,jsx}'",
    "format:js": "prettier --write 'src/**/*.{js,jsx,json,md}'",
    "lint:py": "flake8 src/wavewatch/ surf_api.py",
    "format:py": "black src/wavewatch/ surf_api.py",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cd src/wavewatch/ui/client && npm test -- --watchAll=false",
    "test:e2e": "echo 'E2E tests not yet configured'",
    "check-all": "npm run lint:js && npm run lint:py && npm run test",
    "format": "npm run format:js && npm run format:py"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}

